<!DOCTYPE html>
<html>

<head>
  <meta charset="utf-8">
  <%- include('_styles') %>
</head>

<body>

  <div class="header">
    <div>
      <div class="callsign"><%- ac.callsign || 'Unknown' %>
          <% if (vstatus==='Climbing' ) { %>🛫<% } else if (vstatus==='Descending' ) { %>🛬<% } else { %>✈️<% } %>
      </div>
      <div class="airline"><%- enrichment.airline || ac.country || '' %></div>
    </div>
    <div class="ac-type"><%- enrichment.aircraftType || '' %></div>
  </div>

  <div class="body">
    <div class="left">
      <div class="block">
        <div class="route"><%- enrichment.route || 'Route unknown' %></div>
        <div class="airports">
          <div class="airport-name"><%- enrichment.originName || '' %></div>
          <div class="airport-name"><%- enrichment.destName || '' %></div>
        </div>
      </div>
      <div class="divider"></div>
      <div class="stats-under-route">
        <div class="stat-block">
          <span class="stat-label">Altitude</span>
          <span class="stat-value"><%- altitude %></span>
        </div>
        <div class="stat-block">
          <span class="stat-label">Speed</span>
          <span class="stat-value"><%- speed %></span>
        </div>
      </div>
    </div>

    <div class="right map-column">
      <div class="map-wrap" style="--map-scale:<%= mapScale %>">
        <div class="map-inner" style="width:<%= mapW %>px;height:<%= mapH %>px;">
          <% mapTiles.forEach(function(t) { %>
            <img class="map-tile" src="<%= t.url %>" alt=""
              style="left:<%= t.left %>px;top:<%= t.top %>px;width:<%= t.width %>px;height:<%= t.height %>px;">
            <% }); %>
              <svg class="map-overlay" viewBox="0 0 <%= mapW %> <%= mapH %>" width="<%= mapW %>" height="<%= mapH %>">
                <text class="house-icon" x="<%= centerX %>" y="<%= centerY %>" text-anchor="middle" dominant-baseline="middle">🏠</text>
                <g class="plane-group">
                  <g transform="translate(<%= planeX %>,<%= planeY %>) rotate(<%= planeHeading - 45 %>)">
                    <text class="plane-icon">✈️</text>
                  </g>
                </g>
              </svg>
        </div>
      </div>
    </div>
  </div>

  <div class="footer">
    <span><%- locationName %></span>
    <span>Local time: <%- updatedAt %></span>
  </div>

</body>

</html>