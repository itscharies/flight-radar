<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  html, body {
    width: 960px; height: 540px; overflow: hidden;
    background: #fff; font-family: 'Arial', sans-serif;
    color: #111;
  }
  body {
    display: flex; flex-direction: column;
    flex-shrink: 0;
  }

  /* ── Header ── */
  .header {
    flex-shrink: 0;
    display: flex; align-items: center; justify-content: space-between;
    padding: 22px 32px 18px;
    border-bottom: 2px solid #111;
  }
  .callsign  { font-size: 50px; font-weight: bold; letter-spacing: 2px; }
  .airline   { font-size: 26px; color: #555; margin-top: 6px; }
  .ac-type   { font-size: 22px; color: #888; text-align: right; }

  /* ── Body ── */
  .body {
    flex: 1; min-height: 0; overflow: hidden;
    display: flex;
  }

  /* Left column */
  .left {
    flex: 1; min-width: 0; padding: 28px 32px;
    border-right: 2px solid #ddd;
    display: flex; flex-direction: column; gap: 20px;
    overflow: hidden;
  }
  .route {
    font-size: 38px; font-weight: bold;
  }
  .airport-name {
    font-size: 20px; color: #666; margin-top: -8px;
  }
  .stats-under-route {
    display: flex; gap: 24px; margin-top: 12px;
  }
  .stat-block {
    display: flex; flex-direction: column; gap: 4px;
  }
  .stat-block .stat-label {
    font-size: 14px; text-transform: uppercase;
    letter-spacing: 1px; color: #999;
  }
  .stat-block .stat-value {
    font-size: 22px; font-weight: bold; color: #111;
  }

  /* Right column — map (full size, no padding) */
  .right.map-column {
    flex-shrink: 0; width: 356px; padding: 0;
    display: flex; align-items: center; justify-content: center;
    overflow: hidden;
  }
  .map-wrap {
    position: relative;
    overflow: hidden;
    flex-shrink: 0;
  }
  .map-inner {
    position: absolute;
    left: 0;
    top: 0;
    transform: scale(0.5);
    transform-origin: 0 0;
  }
  .map-tile {
    position: absolute;
    display: block;
    pointer-events: none;
    filter: brightness(0.69) contrast(3) grayscale(1);
  }
  .map-overlay {
    position: absolute;
    left: 0;
    top: 0;
    pointer-events: none;
  }

  /* ── Footer ── */
  .footer {
    flex-shrink: 0;
    border-top: 2px solid #ddd;
    padding: 14px 32px;
    display: flex; justify-content: space-between;
    font-size: 18px; color: #999;
  }

  /* Empty state */
  .empty-state {
    width: 960px; height: 540px; overflow: hidden;
    background: #fff; font-family: 'Arial', sans-serif;
    display: flex; flex-direction: column;
    align-items: center; justify-content: center;
  }
  .empty-state h1 { font-size: 44px; color: #333; margin-bottom: 16px; }
  .empty-state p  { font-size: 24px; color: #999; }
</style>
