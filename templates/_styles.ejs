<%- include('_base') %>
<style>
  html, body {
    width: 960px; height: 540px; overflow: hidden;
    background: #fff; font-family: 'Arial', sans-serif;
    color: #111;
  }
  body {
    display: flex; flex-direction: column;
    flex-shrink: 0;
  }

  /* ── Header ── */
  .header {
    flex-shrink: 0;
    height: 120px;
    display: flex; align-items: center; justify-content: space-between;
    padding: 0 32px;
    border-bottom: 2px solid #111;
  }
  .callsign  { font-size: 48px; font-weight: bold; }
  .airline   { font-size: 18px; color: #555; margin-top: -6px; }
  .ac-type   { font-size: 32px; color: #888; text-align: right; }

  /* ── Body ── */
  .body {
    flex: 1; min-height: 0; overflow: hidden;
    display: flex;
  }

  /* Left column */
  .left {
    flex: 1; min-width: 0; padding: 28px 32px;
    border-right: 2px solid #ddd;
    display: flex; flex-direction: column; gap: 20px;
    overflow: hidden;
  }
  .block {
    display: flex; flex-direction: column; gap: 8px;
  }
  .route {
    font-size: 64px; font-weight: bold;
  }
  .airports {
    display: flex; flex-direction: column; gap: 8px;
  }
  .airport-name {
    font-size: 24px; color: #666;
  }
  .divider {
    border-bottom: 2px solid #ddd;
  }
  .stats-under-route {
    display: flex; gap: 24px;
  }
  .stat-block {
    display: flex; flex-direction: column; gap: 4px;
  }
  .stat-block .stat-label {
    font-size: 14px; text-transform: uppercase;
    letter-spacing: 1px; color: #999;
  }
  .stat-block .stat-value {
    font-size: 22px; font-weight: bold; color: #111;
  }

  /* Right column — map square (body height = 369px; header 120 + footer 51 + borders = 171) */
  .right.map-column {
    flex-shrink: 0;
    width: 369px;
    height: 100%;
    padding: 0;
    display: flex;
    overflow: hidden;
  }
  .map-wrap {
    position: relative;
    width: 369px;
    height: 369px;
    flex-shrink: 0;
    overflow: hidden;
  }
  .map-inner {
    position: absolute;
    left: 0;
    top: 0;
    transform-origin: 0 0;
    transform: scale(var(--map-scale, 0.5));
  }
  .map-tile {
    position: absolute;
    display: block;
    pointer-events: none;
    filter: invert(1) brightness(8) contrast(0.5) brightness(2.2) contrast(1.2);
  }
  .map-overlay {
    position: absolute;
    left: 0;
    top: 0;
    pointer-events: none;
  }
  .plane-group {
    filter: drop-shadow(34px 84px 2px rgba(0, 0, 0, 0.6));
  }
  .plane-icon {
    font-size: 64px;
  }
  .house-icon {
    font-size: 64px;
    filter: drop-shadow(0 0 4px rgba(0, 0, 0, 0.8));
  }

  /* ── Footer ── */
  .footer {
    flex-shrink: 0;
    height: 51px;
    border-top: 2px solid #ddd;
    padding: 0 32px;
    display: flex; align-items: center; justify-content: space-between;
    font-size: 18px; color: #999;
  }

  /* Empty state */
  .empty-state {
    width: 960px; height: 540px; overflow: hidden;
    background: #fff; font-family: 'Arial', sans-serif;
    display: flex; flex-direction: column;
    align-items: center; justify-content: center;
  }
  .empty-state h1 { font-size: 44px; color: #333; margin-bottom: 16px; }
  .empty-state p  { font-size: 24px; color: #999; }
</style>
