<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<style>
* { margin: 0; padding: 0; box-sizing: border-box; }
html { width: 960px; }
body {
  width: 960px;
  height: 1080px; /* 540 main + 540 sprite zone */
  background: #f5f5f5;
  font-family: -apple-system, "Helvetica Neue", Arial, sans-serif;
  overflow: hidden;
  position: relative;
}

/* ── Main screen (y: 0–540) ── */
/* Tile positions must exactly match TILE_BUTTON_DEFS in screens/launcher.js:
   Tile 1: x=24 y=24 w=444 h=492
   Tile 2: x=492 y=24 w=444 h=492                                         */
.screen {
  position: absolute;
  left: 0; top: 0; width: 960px; height: 540px;
  overflow: hidden;
}
.tile {
  position: absolute;
  top: 24px; width: 444px; height: 492px;
  background: #fff;
  border: 2px solid #ddd;
  border-radius: 16px;
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  gap: 18px;
}
.tile:nth-child(1) { left: 24px; }
.tile:nth-child(2) { left: 492px; }
.tile-icon  { font-size: 96px; line-height: 1; }
.tile-label {
  font-size: 18px; font-weight: 700;
  letter-spacing: 0.14em; text-transform: uppercase; color: #111;
}

/* ── Sprite zone (y: 540–1080) — pressed states ── */
/* Same x/w/h as normal tiles, just rendered below the fold */
.sprite-zone {
  position: absolute;
  left: 0; top: 540px; width: 960px; height: 540px;
  overflow: hidden;
}
.tile-pressed {
  position: absolute;
  top: 24px; width: 444px; height: 492px;
  background: #111;
  border: 2px solid #111;
  border-radius: 16px;
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  gap: 18px;
}
.tile-pressed:nth-child(1) { left: 24px; }
.tile-pressed:nth-child(2) { left: 492px; }
.tile-pressed .tile-icon  { font-size: 96px; line-height: 1; filter: invert(1); }
.tile-pressed .tile-label {
  font-size: 18px; font-weight: 700;
  letter-spacing: 0.14em; text-transform: uppercase; color: #fff;
}
</style>
</head>
<body>

<div class="screen">
  <% apps.forEach(function(app) { %>
  <div class="tile">
    <div class="tile-icon"><%= app.icon %></div>
    <div class="tile-label"><%= app.label %></div>
  </div>
  <% }); %>
</div>

<div class="sprite-zone">
  <% apps.forEach(function(app) { %>
  <div class="tile-pressed">
    <div class="tile-icon"><%= app.icon %></div>
    <div class="tile-label"><%= app.label %></div>
  </div>
  <% }); %>
</div>

</body>
</html>
